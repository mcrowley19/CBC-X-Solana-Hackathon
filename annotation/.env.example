# Copy to annotation/.env. The payout key can also come from the repo .env.local.

LOGBOOK_HOST=http://127.0.0.1:3000
DEVICE_API_KEY=
DRIVER_WALLET=
DEVICE_ID=pi-01

# auto uses mlx on a Mac and stub everywhere else. stub | mlx | ollama
VLM_BACKEND=auto
# 16 GB Mac: mlx-community/Qwen3-VL-4B-Instruct-4bit
# 32 GB Mac: mlx-community/Qwen3-VL-8B-Instruct-4bit
VLM_MODEL=

YOLO_MODEL=yolo11n.pt
# cpu, or mps on a Mac
YOLO_DEVICE=

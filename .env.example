# Copy to .env.local, or run `npm run setup`, which generates everything below.

# Solana cluster the server uses. Devnet: https://api.devnet.solana.com   Local: http://127.0.0.1:8899
SOLANA_RPC_URL=https://api.devnet.solana.com
# Same cluster, exposed to the browser (Phantom connection + Explorer links).
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Base58 secret key of the treasury wallet that pays rewards and fees. Never commit this.
TREASURY_SECRET_KEY=
# The MILE token mint address (created by `npm run setup`).
REWARD_MINT=
NEXT_PUBLIC_REWARD_MINT=
NEXT_PUBLIC_TOKEN_SYMBOL=MILE

# Shared secret the Raspberry Pi sends as `Authorization: Bearer <key>`. At least 16 characters.
DEVICE_API_KEY=

# Enables the unauthenticated "Simulate a drive" endpoint. Only for test tokens.
DEMO_MODE=false
